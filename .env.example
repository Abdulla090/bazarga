# =============================================================================
# Reelcart (formerly Bazarga) — environment variables
#
# On Vercel: Project → Settings → Environment Variables (paste name + value, pick "Production").
# Locally:   copy this file to .env.local (npm run dev) or .env (docker compose).
#
# Every variable the code reads is listed here. Everything is validated at first use
# (src/server/env.ts); the build never needs secrets. A feature whose keys are empty simply
# switches itself off — nothing breaks. See docs/SETUP.md for where to click for each one.
# =============================================================================


# #############################################################################
#  REQUIRED
# #############################################################################

# The public address of your site, no trailing slash. Used in emails, share links, QR codes and
# payment return URLs. First deploy on Vercel: https://<your-project>.vercel.app
APP_URL=http://localhost:3000

# Postgres connection string.
#  - Vercel + Supabase integration: leave DATABASE_URL empty — the integration injects
#    POSTGRES_URL / POSTGRES_URL_NON_POOLING and Reelcart uses them automatically.
#  - Any other Postgres (Neon, Supabase by hand, your VPS): postgres://user:pass@host:5432/db?sslmode=require
#  - Zero-setup local dev: pglite://./.pglite (embedded Postgres in a folder)
DATABASE_URL=pglite://./.pglite

# Long random string (16+ chars, e.g. `openssl rand -hex 24`). Protects the daily cron job
# (/api/cron/daily: plan expiry, payment checks, cleanup). Unset = cron routes are off (404).
CRON_SECRET=

# Comma-separated emails allowed into /admin (activate seller plans, payouts, waitlist).
# Sign up with one of these emails on your site, and you are the admin. Unset = /admin is 404.
ADMIN_EMAILS=


# #############################################################################
#  OPTIONAL — injected for you by integrations (do not type these by hand on Vercel)
# #############################################################################

# Supabase integration (Vercel Marketplace) sets these. POSTGRES_URL is used when DATABASE_URL is
# empty; the non-pooling URL is used for migrations; SUPABASE_* enable photo storage in Supabase.
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name in Supabase (created automatically if missing). Default: uploads
SUPABASE_BUCKET=
# Direct (non-pooled) Postgres URL for migrations if your provider has one (Neon). Optional.
DATABASE_URL_UNPOOLED=
# Vercel sets VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA automatically (build info on /api/health).


# #############################################################################
#  OPTIONAL — demo store
# #############################################################################

# The demo store "Studio Hawler" (/s/hawler-bazaar) is created on every deploy unless this is false.
# Set SEED_DEMO=false BEFORE your first deploy to launch with an empty platform.
SEED_DEMO=true
# Demo seller login (only used when the demo is created). Change the password if you keep the demo.
SEED_DEMO_EMAIL=demo@mymarket.app
SEED_DEMO_PASSWORD=mymarket-demo
# Plan of the demo store, re-applied on every deploy (free | pro | business | max). Default max so the demo shows every feature.
SEED_DEMO_PLAN=max


# #############################################################################
#  OPTIONAL — custom domain + store subdomains
# #############################################################################

# Your root domain, e.g. reelcart.app. Turns on <store>.reelcart.app → that store.
# Needs the domain AND *.domain (wildcard) added in Vercel → Domains. Empty = off (stores live at APP_URL/s/<store>).
ROOT_DOMAIN=
# Kill switch: set to false to stop subdomain routing while keeping ROOT_DOMAIN.
STORE_SUBDOMAINS=

# Sellers' own domains (Business+, Dashboard -> Settings -> Custom domain). The DNS target sellers point at;
# defaults are Vercel's (CNAME cname.vercel-dns.com for shop.brand.com, A 76.76.21.21 for brand.com).
CUSTOM_DOMAIN_CNAME=
CUSTOM_DOMAIN_A=
# Optional: attach a seller's saved domain to your Vercel project automatically (token with project access).
# Empty = you add each verified domain by hand in Vercel -> Settings -> Domains.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=


# #############################################################################
#  OPTIONAL — product photo storage (Cloudflare R2 recommended at scale)
# #############################################################################

# Unset = automatic: R2/S3 when its keys are complete, else Supabase Storage on Vercel, else local disk.
# Force one with: r2 | s3 | supabase | local
STORAGE_DRIVER=
# Cloudflare R2 (free 10 GB): fill these four + the public URL.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for images, e.g. https://pub-xxxx.r2.dev or https://img.yourdomain.com
R2_PUBLIC_URL=
# Any other S3-compatible bucket (AWS S3, MinIO). These win over the R2_* names when set.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Local disk driver only (VPS / docker): folder for uploads
UPLOAD_DIR=./uploads
# Max upload size per photo, MB (photos are also compressed in the browser before upload)
MAX_UPLOAD_MB=5


# #############################################################################
#  OPTIONAL — email (password reset, email verification, seller notifications)
# #############################################################################

# console (default: emails are written to the server log) | resend (free 3,000/mo) | brevo (free 300/day)
EMAIL_PROVIDER=
# The API key for the provider you chose
EMAIL_API_KEY=
# Sender. The domain must be verified at your email provider.
EMAIL_FROM=Reelcart <hello@yourdomain.com>
# Older / provider-specific names (still work; win over EMAIL_API_KEY when set)
EMAIL_DRIVER=
RESEND_API_KEY=
BREVO_API_KEY=


# #############################################################################
#  OPTIONAL — seller notifications for new orders
# #############################################################################

# Comma-separated: console,telegram,whatsapp,email
NOTIFY_CHANNELS=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Web push (new-order alerts on the seller's phone). Generate once: npx web-push generate-vapid-keys
# Leave any empty and the feature hides itself.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@yourdomain.com


# #############################################################################
#  OPTIONAL — online payments (Rasedi gateway: FIB, ZainCash, AsiaPay, NassWallet, cards)
#  Cash on delivery always works without any of this. See docs/PAYMENTS.md.
# #############################################################################

# none (default: online payments hidden everywhere) | rasedi
PAYMENTS_PROVIDER=none
# test | live  (live refuses a test_ key)
RASEDI_MODE=test
RASEDI_API_BASE=https://api.rasedi.com
# Rasedi panel "secret key", e.g. test_xxx / live_xxx
RASEDI_KEY_ID=
# Ed25519 private key PEM. One line with \n escapes is fine on Vercel.
RASEDI_PRIVATE_KEY=
# 24+ random chars (openssl rand -hex 24); protects the payment webhook
RASEDI_WEBHOOK_SECRET=
# Methods shown on the payment page
RASEDI_GATEWAYS=FIB,ZAIN,ASIA_PAY,NASS_WALLET,CREDIT_CARD
# IQD amounts are sent x100 per the Rasedi API reference
RASEDI_AMOUNT_SCALE=100
RASEDI_FEE_FROM_CUSTOMER=false
# Plan prices in IQD = USD x this rate (rounded to 250)
USD_IQD_RATE=1310
# Platform commission per storefront order, basis points (100 = 1%)
PLATFORM_COMMISSION_BPS=0
# Unpaid online orders are cancelled (stock released) after this many minutes
PAYMENT_ORDER_TTL_MINUTES=60
# Dev only: allow the mock payment provider in production builds (never set on a real site)
PAYMENTS_ALLOW_MOCK=

# Legacy direct integrations (kept for reference; Rasedi is the supported path). Leave false.
FIB_ENABLED=false
FIB_BASE_URL=https://fib.stage.fib.iq
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
ZAINCASH_ENABLED=false
ZAINCASH_BASE_URL=https://pg-api-uat.zaincash.iq
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
ZAINCASH_API_KEY=
ZAINCASH_SCOPE=payment:read payment:write
FASTPAY_ENABLED=false
QICARD_ENABLED=false


# #############################################################################
#  OPTIONAL — AI store builder (photos + message → draft products)
# #############################################################################

AI_ENABLED=false
# openai = any OpenAI-compatible /chat/completions endpoint with vision; mock = offline demo
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# AI text: "Write with AI" product descriptions (Business+) and the AI Website Designer (Max).
# Your own key (Hark/Reelcart never ships one). Any one switches it on; Gemini wins if both are set.
# No key: the tools are hidden for sellers; operators (ADMIN_EMAILS) see a "connect AI" note.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# The seeded demo seller gets an offline mock when no key is set, so the demo shows the feature. false = off.
AI_DEMO_MOCK=true

# Sign in with WhatsApp (6-digit code, 5 minutes). Set ONE provider; none = the option stays hidden ("coming soon").
# a) WhatsApp Cloud API (Meta Business): permanent token, phone number ID, and an approved AUTHENTICATION template
#    whose body takes the code ({{1}}) and has a copy-code button.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=login_code
WHATSAPP_TEMPLATE_LANG=en
# b) Twilio WhatsApp sender
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Local testing without a provider: codes go to the server log (and the screen outside production).
OTP_MOCK=


# #############################################################################
#  OPTIONAL — monitoring, logging, tuning
# #############################################################################

# HTTPS webhook (Discord / Slack / any JSON sink): every server error is also posted here (redacted).
LOG_WEBHOOK_URL=
# debug | info | warn | error
LOG_LEVEL=info
# Postgres pool size per server instance (default 3 on serverless, 10 elsewhere)
DATABASE_POOL_MAX=
# Only for a self-signed Postgres you control: false disables TLS certificate checks
DATABASE_SSL_REJECT_UNAUTHORIZED=
# 1 = log query counts per request (performance debugging)
DB_QUERY_STATS=
SESSION_COOKIE_NAME=mm_session
SESSION_TTL_DAYS=30
# Phone OTP driver (only "console" in v1)
OTP_DRIVER=console
# Build label shown on /api/health when not on Vercel (docker / VPS)
GIT_SHA=
APP_VERSION=


# #############################################################################
#  docker-compose only (self-hosting on a VPS; not used on Vercel)
# #############################################################################

POSTGRES_USER=mymarket
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=mymarket
APP_PORT=3000
