# =============================================================================
# my market — environment. Copy to .env (docker compose) or .env.local (npm run dev).
# Only DATABASE_URL + APP_URL matter to run; everything else is optional.
# =============================================================================

# --- Core -------------------------------------------------------------------
# Production: postgres://user:pass@host:5432/db   (Neon/Supabase: append ?sslmode=require)
# Zero-setup local dev: pglite://./.pglite  (embedded Postgres in a folder; one process at a time)
DATABASE_URL=pglite://./.pglite
DATABASE_POOL_MAX=10
APP_URL=http://localhost:3000
# Storefront subdomains: {slug}.ROOT_DOMAIN → /s/{slug}  (needs wildcard DNS + TLS)
ROOT_DOMAIN=mymarket.app
SESSION_COOKIE_NAME=mm_session
SESSION_TTL_DAYS=30
LOG_LEVEL=info

# docker-compose only
POSTGRES_USER=mymarket
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=mymarket
APP_PORT=3000
SEED_DEMO=true

# --- Image storage ------------------------------------------------------------
# local = disk (UPLOAD_DIR, served by /api/files/*); s3 = any S3-compatible bucket (Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# R2 example: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects, e.g. https://img.mymarket.app or https://pub-xxxx.r2.dev
S3_PUBLIC_URL=

# --- Email (password reset, seller notifications) -----------------------------
# console = print to server log (dev). resend = https://resend.com
EMAIL_DRIVER=console
EMAIL_FROM=my market <hello@mymarket.app>
RESEND_API_KEY=

# --- Seller notifications (comma-separated: console,telegram,whatsapp,email) ---
NOTIFY_CHANNELS=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- Phone / WhatsApp OTP (stub) ---------------------------------------------
OTP_DRIVER=console

# --- Payments -------------------------------------------------------------------
# Cash on Delivery always works. Online providers appear to customers only when enabled + configured
# here AND the seller switches them on in Dashboard → Payments.
FIB_ENABLED=false
FIB_BASE_URL=https://fib.stage.fib.iq
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=

ZAINCASH_ENABLED=false
ZAINCASH_BASE_URL=https://pg-api-uat.zaincash.iq
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
# Merchant API key used to verify HS256 redirect/webhook JWTs
ZAINCASH_API_KEY=
ZAINCASH_SCOPE=payment:read payment:write

# Stubs — not implemented yet; leave false
FASTPAY_ENABLED=false
QICARD_ENABLED=false

# --- AI store builder (photos + message → draft products) ---------------------
AI_ENABLED=false
# openai = any OpenAI-compatible /chat/completions endpoint with vision; mock = offline demo
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Seed ------------------------------------------------------------------------
SEED_DEMO_EMAIL=demo@mymarket.app
SEED_DEMO_PASSWORD=mymarket-demo
